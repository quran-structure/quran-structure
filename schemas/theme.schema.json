{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Theme",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "related_terms_ar",
    "related_terms_en"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "related_terms_ar": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_terms_en": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
